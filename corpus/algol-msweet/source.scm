;;; algol-msweet.scm - ALGOL + M-Expression + Sweet-Expression Reader

;; 1. Character & String Helpers
(define (whitespace? c) (or (char=? c #\space) (char=? c #\tab)))
(define (delimiter? c)
  (or (eof-object? c) (whitespace? c) (char=? c #\newline)
      (memv c '(#\[ #\] #\{ #\} #\( #\) #\; #\,))))

(define (string-trim-left str)
  (let loop ((i 0))
    (if (and (< i (string-length str)) (whitespace? (string-ref str i)))
        (loop (+ i 1))
        (substring str i (string-length str)))))

(define (count-indent str)
  (let loop ((i 0))
    (if (and (< i (string-length str)) (char=? (string-ref str i) #\space))
        (loop (+ i 1))
        i)))

;; 2. Tokenizer & Inline M-Exp Parser (Supports ',' and ';' separators)
(define (read-atom port)
  (let loop ((chars '()))
    (let ((c (peek-char port)))
      (if (delimiter? c)
          (let ((s (list->string (reverse chars))))
            (or (string->number s)
                (cond ((string=? s "T") #t)
                      ((string=? s "F") #f)
                      ((string=? s "→") '->)
                      ((string=? s "λ") 'lambda)
                      ((string=? s "=") '=)
                      ((string=? s ":=") ':=)
                      (else (string->symbol s)))))
          (loop (cons (read-char port) chars))))))

(define (read-delimited-list port close-char allow-seps?)
  (let loop ((items '()))
    (let ((c (peek-char port)))
      (cond ((eof-object? c) (error "Unexpected EOF inside brackets"))
            ((whitespace? c) (read-char port) (loop items))
            ((and allow-seps? (or (char=? c #\;) (char=? c #\,)))
             (read-char port) (loop items))
            ((char=? c close-char) (read-char port) (reverse items))
            (else (loop (cons (read-inline port) items)))))))

(define (auto-infix exprs)
  (if (and (list? exprs) (= (length exprs) 3)
           (memq (cadr exprs) '(+ - * / = < > <= >= eq? equal? and or)))
      (list (cadr exprs) (car exprs) (caddr exprs))
      exprs))

(define (read-inline port)
  (let loop ()
    (let ((c (peek-char port)))
      (cond ((eof-object? c) c)
            ((whitespace? c) (read-char port) (loop))
            ((char=? c #\{)
             (read-char port)
             (auto-infix (read-delimited-list port #\} #f)))
            ((char=? c #\()
             (read-char port)
             (read-delimited-list port #\) #f))
            (else
             (let ((atom (read-atom port)))
               (if (and (not (eof-object? (peek-char port)))
                        (char=? (peek-char port) #\[))
                   (begin
                     (read-char port)
                     (let ((args (read-delimited-list port #\] #t)))
                       (cons atom args)))
                   atom)))))))

(define (parse-line-tokens line-str)
  (let ((port (open-input-string line-str)))
    (let loop ((tokens '()))
      (let ((tok (read-inline port)))
        (if (eof-object? tok)
            (reverse tokens)
            (loop (cons tok tokens)))))))

;; 3. ALGOL Sugar & Indentation Block Parser
(define (split-on sym lst)
  (let loop ((rem lst) (left '()))
    (cond ((null? rem) (values (reverse left) '()))
          ((eq? (car rem) sym) (values (reverse left) (cdr rem)))
          (else (loop (cdr rem) (cons (car rem) left))))))

(define (desugar-line tokens)
  (cond
    ((and (>= (length tokens) 2) (eq? (cadr tokens) '=))
     (append (list 'define (car tokens)) (cddr tokens)))
    ((and (>= (length tokens) 4) (eq? (car tokens) 'let) (eq? (caddr tokens) ':=))
     (list 'let-binding (cadr tokens) (auto-infix (cdddr tokens))))
    ((and (>= (length tokens) 3) (eq? (car tokens) 'if))
     (call-with-values
      (lambda () (split-on 'then (cdr tokens)))
      (lambda (test-expr rest)
        (let ((clean-test (if (= (length test-expr) 1)
                              (car test-expr)
                              (auto-infix test-expr))))
          (if (null? rest)
              (list 'if clean-test)
              (append (list 'if clean-test) rest))))))
    ((and (>= (length tokens) 3) (eq? (cadr tokens) '->))
     (list (auto-infix (list (car tokens))) (caddr tokens)))
    ((= (length tokens) 1) (car tokens))
    (else (auto-infix tokens))))

(define (collapse-algol-blocks forms)
  (let loop ((rem forms) (acc '()))
    (cond
      ((null? rem) (reverse acc))
      ((and (list? (car rem)) (eq? (caar rem) 'if) (= (length (car rem)) 2)
            (>= (length rem) 4) (eq? (caddr rem) 'else))
       (let ((if-form (list 'if (cadar rem) (cadr rem) (cadddr rem))))
         (loop (cddddr rem) (cons if-form acc))))
      ((and (list? (car rem)) (eq? (caar rem) 'let-binding))
       (let gather ((r rem) (bindings '()))
         (cond ((and (not (null? r)) (list? (car r)) (eq? (caar r) 'let-binding))
                (let* ((b (car r))
                       (val (if (= (length (caddr b)) 1) (caaddr b) (caddr b))))
                  (gather (cdr r) (cons (list (cadr b) val) bindings))))
               ((and (not (null? r)) (eq? (car r) 'in) (not (null? (cdr r))))
                (loop (cddr r)
                      (cons (list 'let* (reverse bindings) (cadr r)) acc)))
               (else (loop (cdr rem) (cons (car rem) acc))))))
      (else (loop (cdr rem) (cons (car rem) acc))))))

(define (read-lines port)
  (let loop ((lines '()))
    (let ((line (read-line port)))
      (if (eof-object? line)
          (reverse lines)
          (let ((trimmed (string-trim-left line)))
            (if (or (string=? trimmed "") (char=? (string-ref trimmed 0) #\#))
                (loop lines)
                (loop (cons (cons (count-indent line) (parse-line-tokens trimmed))
                            lines))))))))

(define (parse-block lines base-indent)
  (let loop ((rem lines) (acc '()))
    (if (or (null? rem) (< (caar rem) base-indent))
        (values (collapse-algol-blocks (reverse acc)) rem)
        (let* ((curr (car rem))
               (indent (car curr))
               (tokens (cdr curr))
               (next (cdr rem)))
          (if (and (not (null? next)) (> (caar next) indent))
              (call-with-values
               (lambda () (parse-block next (caar next)))
               (lambda (children rest)
                 (let ((head (desugar-line tokens)))
                   (loop rest (cons (if (list? head)
                                        (append head children)
                                        (cons head children))
                                    acc)))))
              (loop next (cons (desugar-line tokens) acc)))))))

(define (algol-msweet-read str)
  (let ((lines (read-lines (open-input-string str))))
    (call-with-values
     (lambda () (parse-block lines 0))
     (lambda (forms _) forms))))
